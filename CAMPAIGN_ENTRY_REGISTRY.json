      "headline": "Own a Home in the South Bay?",
      "cta": "Start My Coverage Review"
    },
    {
      "id": "stevies_coaster_bundle_back",
      "route": "/auto-bundle/",
      "family": "home_auto",
      "visual_mode": "ui3_bundle",
