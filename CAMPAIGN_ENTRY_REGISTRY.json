      "headline": "Own the Home. Drive the Cars.",
      "cta": "Start My Home + Auto Review"
    },
    {
      "id": "occupation_tech_meta_v1",
      "route": "/tech/",
      "family": "professional",
      "visual_mode": "ui3_professional",
      "headline": "Work in Tech?",
      "cta": "Check My Eligibility"
    },
    {
      "id": "occupation_teacher_meta_v1",
      "route": "/teachers/",
